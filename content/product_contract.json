      "schema_version": 1,
      "id": "progression.blade_endings",
      "display_name": "Blade ending and extra-stage policy",
      "canonical_ending_condition": "main_campaign_no_continue",
      "continued_ending_condition": "main_campaign_continue_used",
      "extra_stage_unlock_condition": "main_campaign_1cc_any_difficulty",
      "extra_stage_story_condition": "canonical_ending_complete"
    }
  },
  "runtime_geometry": {
    "schema_version": 1,
    "id": "geometry.blade_playfield",
    "display_name": "Blade logical output and gameplay plane",
    "logical_output": {
      "width": 640,
      "height": 360
    },
    "gameplay_plane": {
      "x_min": 185,
      "x_max_exclusive": 455,
      "y_min": 0,
      "y_max_exclusive": 360,
      "width": 270,
      "height": 360,
      "containment": "The plane is half-open. Point anchors must lie inside it, and declared hurtboxes must be fully contained. Coordinates use a binary 1/1024-logical-pixel grid; clamp right and bottom coordinates to the exclusive maximum minus one grid step.",
      "anchor_containment": "point_inside_half_open_plane",
      "hurtbox_containment": "fully_contained_in_half_open_plane",
      "coordinate_grid": "binary_fixed_1_1024_logical_pixel",
      "right_bottom_clamp": "exclusive_max_minus_one_grid_step"
    }
  },
  "product_requirements": {
    "gameplay": "Gameplay is a strictly vertical-scrolling 2D shmup. Perspective 3D is presentation only and never owns collisions, bullets, player motion, or stage anchors.",
    "enemy_emission_gate": "An enemy may appear outside the gameplay plane, but each attempted emission declares one gate: either a point anchor or a hurtbox. A declared point must lie inside the half-open gameplay plane, and a declared hurtbox must be fully contained; otherwise that attempt remains locked.",
    "boss_phase_policy": "Every boss phase break has a readable ring-style recharge telegraph lasting roughly two seconds. Large bosses may lose, replace, regrow, or transform parts between phases.",
    "defeat_feedback": "Ordinary enemy defeats use generous, large, readable particles. Accessibility settings may reduce density but must not obscure dangerous bullets.",
    "presentation": "Stage 1 travels through a textured perspective 3D forest authored with -Z as world up. High-quality pixel art supplies texture maps, character and enemy sprites, bullets, UI, effects, and separate camera-facing fae and light billboards. Gameplay remains on the fixed 2D plane. The UI is ornate and Blade-specific, informed by Selkies rather than copied from it.",
    "asset_authoring": "New assets use the governed editable-source to runtime-export pipeline. Codex-created raster art requires image generation and deliberate pixel-art finishing in KRA source; quick geometry stand-ins are not production art."
  },
